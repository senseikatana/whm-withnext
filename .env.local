# InsForge Backend
# Obtener de: npx @insforge/cli secrets get ANON_KEY
# URL: campo oss_host de .insforge/project.json
NEXT_PUBLIC_INSFORGE_URL=https://<appkey>.<region>.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=anon_<tu-anon-key>

# Gemini API (opcional)
# Obtener de: https://aistudio.google.com/apikey
# Se puede configurar también desde la UI del SGA
# GEMINI_API_KEY=
